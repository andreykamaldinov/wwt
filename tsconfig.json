{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"baseUrl": ".",
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["vite-plugin-svgr/client", "vitest/globals"],
		"paths": {
			"@api/*": ["./src/shared/api/*"],
			"@temp/*": ["./src/shared/temp/*"],
			"@shared/*": ["./src/shared/*"],
			"@store/*": ["./src/store/*"],
			"@home/*": ["./src/pages/home/*"],
			"@filter-modal/*": ["./src/pages/home/filter-modal/*"]
		},

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true
	},
	"include": ["custom.d.ts", "env.d.ts", "src", "setupTest.ts"],
	"exclude": ["node_modules", "tmp", ".vscode", ".husky"],
	"references": [
		{
			"path": "./tsconfig.node.json"
		}
	]
}
